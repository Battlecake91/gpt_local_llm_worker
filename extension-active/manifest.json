{
  "manifest_version": 3,
  "name": "GPT Active Chat Bridge",
  "version": "0.1.0",
  "description": "Opt-in read-only synchronization of currently open ChatGPT tabs with a local Python GUI.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:8766/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["extractor.js", "bridge.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Active Chat Bridge",
    "default_popup": "popup.html"
  }
}